{
    "name":  "dsh-codex-exec",
    "version":  "0.3.4",
    "type":  "module",
    "description":  "Let DSH plan and review while Codex executes: one codex_exec tool over `codex exec --json`, with selectable model, effort and role, plus an in-session selector.",
    "main":  "./lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "immediately":  true,
                               "platform":  "web"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  "*"
                         }
}